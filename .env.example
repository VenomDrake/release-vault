# ============================================================================
# GitHub & Nexus Mods Release Vault — Environment Configuration (Optional)
# All settings can also be configured interactively via the Web UI Setup Wizard!
# ============================================================================

# Storage paths
VAULT_DATA_DIR=/srv/github-vault
VAULT_ARCHIVE_DIR=/srv/github-vault/archives
VAULT_DB_PATH=/srv/github-vault/vault.db

# Initial Admin Credentials (used only on first database creation)
VAULT_DEFAULT_USER=admin
VAULT_DEFAULT_PASS=admin

# Optional: Internal API URL for the 24/7 Telegram Bot
VAULT_API_URL=http://127.0.0.1:8080

# Optional: Telegram Bot fallback (if not set via Web UI Setup Wizard)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
